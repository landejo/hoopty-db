{
  "manifest_version": 3,
  "name": "Hoopty Scout",
  "version": "0.2.0",
  "description": "Sync saved vehicle listings (Facebook Marketplace, CarGurus, Cars.com, Autotrader, Cars & Bids, Bring a Trailer) to the local Hoopty Scout workbench.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.cargurus.com/*",
    "*://*.cars.com/*",
    "*://*.autotrader.com/*",
    "*://*.carsandbids.com/*",
    "*://*.bringatrailer.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "*://*.duckduckgo.com/*",
    "*://*.bing.com/*",
    "*://*.google.com/*",
    "*://*.ebay.com/*",
    "*://*.classic.com/*",
    "*://*.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "common.js",
        "adapters/facebook.js",
        "adapters/search.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.cargurus.com/*"
      ],
      "js": [
        "common.js",
        "adapters/cargurus.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.cars.com/*"
      ],
      "js": [
        "common.js",
        "adapters/carscom.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.autotrader.com/*"
      ],
      "js": [
        "common.js",
        "adapters/autotrader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.carsandbids.com/*"
      ],
      "js": [
        "common.js",
        "adapters/carsandbids.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.bringatrailer.com/*"
      ],
      "js": [
        "common.js",
        "adapters/bat.js",
        "adapters/search.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.duckduckgo.com/*",
        "*://*.bing.com/*",
        "*://*.google.com/*",
        "*://*.ebay.com/*",
        "*://*.classic.com/*",
        "*://*.reddit.com/*"
      ],
      "js": [
        "common.js",
        "adapters/search.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hoopty Scout",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
