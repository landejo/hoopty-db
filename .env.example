# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Deep analysis + profile generation (Opus). Default: claude-opus-5
SCOUT_MODEL_DEEP=claude-opus-5
# Sync-time normalization (Haiku). Default: claude-haiku-4-5
SCOUT_MODEL_FAST=claude-haiku-4-5

# Home base for locality scoring.
SCOUT_HOME_LOCATION=Carmel, CA

# Local server port (extension posts here).
SCOUT_PORT=8765

# Skip listings the source site marks as sold / ended. Set to 0 to keep them.
SCOUT_SKIP_SOLD=1

# Optional: alternate SQLite file (used for demos / tests).
# SCOUT_DB_PATH=data/other.db
