# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Full assessment, provenance classification, new-model profiles. ~$1 per assessment.
SCOUT_MODEL_DEEP=claude-opus-5
# Quick assessment (same prompt, triage tier). ~$0.30 per assessment.
SCOUT_MODEL_MID=claude-sonnet-5
# Sync-time read of every listing. Sonnet ~2c/listing (recommended); claude-haiku-4-5 ~1c.
SCOUT_MODEL_FAST=claude-sonnet-5
# "Re-assess top 15" on the board. Opus 5.5 is ~20% cheaper per token than Opus 5.
SCOUT_MODEL_TOP=claude-opus-5-5

# Auto-publish to GitHub Pages after a sitting (see README). 0 turns it off.
SCOUT_AUTOPUBLISH=1
# Minutes without workbench activity that end a sitting; checkpoint interval in a long one.
SCOUT_AUTOPUBLISH_IDLE_MIN=15
SCOUT_AUTOPUBLISH_CHECKPOINT_MIN=45

# Home base for locality scoring.
SCOUT_HOME_LOCATION=Carmel, CA

# Local server port (extension posts here).
SCOUT_PORT=8765

# Sold / ended listings become market comps by default (0). Set to 1 to drop them.
SCOUT_SKIP_SOLD=0

# Optional: alternate SQLite file (used for demos / tests).
# SCOUT_DB_PATH=data/other.db
